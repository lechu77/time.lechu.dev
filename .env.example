# .env.example
# time.lechu.dev — World Time Buddy clone
#
# This project is a 100% static site with no backend.
# There are NO runtime environment variables required.
#
# The variables below are for optional tooling and deployment automation only.
# Copy to .env for local use. Never commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Public URL of the deployed site (used in meta tags / og:url if templated)
APP_URL=https://time.lechu.dev

# ---------------------------------------------------------------------------
# Cloudflare Pages — Deployment (CI/CD only, not used at runtime)
# ---------------------------------------------------------------------------

# Cloudflare Account ID (found in Cloudflare dashboard → right sidebar)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token with "Cloudflare Pages: Edit" permission
# Generate at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# Cloudflare Pages project name (as configured in the dashboard)
CLOUDFLARE_PROJECT_NAME=time-lechu-dev

# ---------------------------------------------------------------------------
# Feature Flags (build-time only, if a templating step is ever added)
# ---------------------------------------------------------------------------

# Enable Cloudflare Web Analytics snippet (true/false)
FEATURE_CF_ANALYTICS=false

# Cloudflare Web Analytics beacon token (only used if FEATURE_CF_ANALYTICS=true)
CF_ANALYTICS_TOKEN=
